<?xml version="1.0" encoding="UTF-8"?>

<included>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <!-- 彩色日志格式 -->
    <!-- 控制台输出 -->
    <springProperty scope="context" name="COMMON_PATTERN_COLOR" source="logging.console-pattern"
                    defaultValue="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} [%X{tid}] %clr([tenantId: %X{tenantId:-N/A}]){yellow} %highlight([${LOG_LEVEL_PATTERN:-%5p}]) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t:%r]){faint} %clr(%-40.40logger{15}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- 文件输出 -->
    <springProperty scope="context" name="FILE_PATTERN" source="logging.file-pattern"
                    defaultValue="%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}} [%X{tid}] [tenantId: %X{tenantId:-N/A}] [${LOG_LEVEL_PATTERN:-%5p}] ${PID:- } [%-40.40logger{15}] : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- 链路追踪类型 -->
    <springProperty scope="context" name="traceType" source="spring.trace.type" defaultValue="local"/>
    <!-- 应用名称 -->
    <springProperty name="springAppName" scope="context" source="spring.application.name" defaultValue="application"/>
    <!-- 日志文件保存路径 -->
    <springProperty name="logHome" scope="context" source="logging.file.path" defaultValue="${user.home}/logs"/>

    <!-- 日志显隐控制方式 -->
    <springProperty name="enableBizPoint" scope="context" source="logging.enable-biz-point" defaultValue="true"/>
    <springProperty name="enableJson" scope="context" source="logging.file.enable-json" defaultValue="false"/>

    <!-- 告警日志 -->
    <springProperty name="alarmEnabled" scope="context" source="logging.alarm.enabled" defaultValue="false"/>
    <springProperty name="robotId" scope="context" source="logging.alarm.robotId" defaultValue=""/>

    <!-- 文件日志 -->
    <springProperty name="fileEnabled" scope="context" source="logging.file.enabled" defaultValue="false"/>
    <springProperty name="maxHistory" scope="context" source="logging.file.maxHistory" defaultValue="30"/>
    <springProperty name="maxFileSize" scope="context" source="logging.file.maxFileSize" defaultValue="100MB"/>
    <springProperty name="totalSizeCap" scope="context" source="logging.file.totalSizeCap" defaultValue="20GB"/>

    <springProperty scope="context" name="log.level.console" source="logging.level.console" defaultValue="INFO"/>

    <!--阿里云日志服务配置 正式环境-->
    <springProperty name="aliYunLogEnabled" scope="context" source="logging.aliYunLog.enabled"
                    defaultValue="false"/>
    <springProperty name="endpoint" scope="context" source="logging.aliYunLog.endpoint"
                    defaultValue=""/>
    <springProperty name="accessKeyId" scope="context" source="logging.aliYunLog.accessKeyId" defaultValue=""/>
    <springProperty name="accessKeySecret" scope="context" source="logging.aliYunLog.accessKeySecret"
                    defaultValue=""/>
    <springProperty name="project" scope="context" source="logging.aliYunLog.project"
                    defaultValue="gongbaojin"/>
    <springProperty name="logStore" scope="context" source="logging.aliYunLog.logStore" defaultValue=""/>
    <springProperty name="totalSizeInBytes" scope="context" source="aliYunLog.config.totalSizeInBytes"
                    defaultValue="104857600"/>
    <springProperty name="maxBlockMs" scope="context" source="logging.aliYunLog.maxBlockMs" defaultValue="0"/>
    <springProperty name="ioThreadCount" scope="context" source="logging.aliYunLog.ioThreadCount"
                    defaultValue="8"/>
    <springProperty name="batchSizeThresholdInBytes" scope="context"
                    source="logging.aliYunLog.batchSizeThresholdInBytes" defaultValue="524288"/>
    <springProperty name="batchCountThreshold" scope="context" source="logging.aliYunLog.batchCountThreshold"
                    defaultValue="4096"/>
    <springProperty name="lingerMs" scope="context" source="logging.aliYunLog.lingerMs" defaultValue="2000"/>
    <springProperty name="retries" scope="context" source="logging.aliYunLog.retries" defaultValue="10"/>
    <springProperty name="baseRetryBackoffMs" scope="context" source="logging.aliYunLog.baseRetryBackoffMs"
                    defaultValue="100"/>
    <springProperty name="maxRetryBackoffMs" scope="context" source="logging.aliYunLog.maxRetryBackoffMs"
                    defaultValue="50000"/>
    <springProperty name="timeFormat" scope="context" source="logging.aliYunLog.timeFormat"
                    defaultValue="yyyy-MM-dd HH:mm:ss.SSS"/>
    <springProperty name="timeZone" scope="context" source="logging.aliYunLog.timeZone"
                    defaultValue="Asia/Shanghai"/>

    <appender name="CONSOLE_APPENDER" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <!-- 日志的格式化 -->
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.github.sparkzxl.log.layout.ConditionalTraceLayout">
                <traceType>${traceType}</traceType>
                <pattern>${COMMON_PATTERN_COLOR}</pattern>
            </layout>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 控制台异步实时输出 -->
    <appender name="ASYNC_CONSOLE_APPENDER" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
        <queueSize>256</queueSize>
        <!-- 添加附加的appender,最多只能添加一个 -->
        <appender-ref ref="CONSOLE_APPENDER"/>
    </appender>


    <appender name="FILE_APPENDER" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${FILE_LOG_THRESHOLD}</level>
        </filter>
        <file>${logHome}/${springAppName}.log</file>
        <immediateFlush>false</immediateFlush>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${logHome}/%d{yyyy-MM-dd}/${springAppName}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxHistory>${maxHistory}</maxHistory>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>
    <!-- 异步输出文件 -->
    <appender name="ASYNC_FILE_APPENDER" class="com.github.sparkzxl.log.appender.ConditionalAsyncAppender">
        <enabled>${fileEnabled}</enabled>
        <discardingThreshold>0</discardingThreshold>
        <queueSize>256</queueSize>
        <appender-ref ref="FILE_APPENDER"/>
    </appender>

    <appender name="ASYNC_ALARM_APPENDER" class="com.github.sparkzxl.log.appender.AlarmLogLogbackAsyncAppender">
        <enabled>${alarmEnabled}</enabled>
        <robotId>${robotId}</robotId>
        <discardingThreshold>0</discardingThreshold>
        <queueSize>256</queueSize>
        <appender-ref ref="CONSOLE_APPENDER"/>
    </appender>

    <appender name="ALIYUN_SLS_LOG_APPENDER" class="com.github.sparkzxl.log.appender.AliYunLogAppender">
        <enabled>${aliYunLogEnabled}</enabled>
        <!--必选项-->
        <!-- 账号及网络配置 -->
        <endpoint>${endpoint}</endpoint>
        <accessKeyId>${accessKeyId}</accessKeyId>
        <accessKeySecret>${accessKeySecret}</accessKeySecret>

        <!-- sls 项目配置 -->
        <project>${project}</project>
        <logStore>${logStore}</logStore>
        <!--必选项 (end)-->

        <!-- 可选项 -->
        <!--<topic>lws-log</topic>-->

        <!-- 可选项 详见 '参数说明'-->
        <!--单个 producer 实例能缓存的日志大小上限，默认为 100MB。-->
        <totalSizeInBytes>${totalSizeInBytes}</totalSizeInBytes>
        <!--如果 producer 可用空间不足，调用者在 send 方法上的最大阻塞时间，默认为 60 秒。为了不阻塞打印日志的线程
        ，强烈建议将该值设置成 0。-->
        <maxBlockMs>${maxBlockMs}</maxBlockMs>
        <!--执行日志发送任务的线程池大小，默认为可用处理器个数。-->
        <ioThreadCount>${ioThreadCount}</ioThreadCount>
        <!--当一个 ProducerBatch 中缓存的日志大小大于等于 batchSizeThresholdInBytes 时，
        该 batch 将被发送，默认为 512 KB，最大可设置成 5MB。-->
        <batchSizeThresholdInBytes>${batchSizeThresholdInBytes}</batchSizeThresholdInBytes>
        <!--当一个 ProducerBatch 中缓存的日志条数大于等于 batchCountThreshold 时，
        该 batch 将被发送，默认为 4096，最大可设置成 40960。-->
        <batchCountThreshold>${batchCountThreshold}</batchCountThreshold>
        <!-- 一个 ProducerBatch 从创建到可发送的逗留时间，默认为 2 秒，最小可设置成 100 毫秒。-->
        <lingerMs>${lingerMs}</lingerMs>
        <!--  如果某个 ProducerBatch 首次发送失败，能够对其重试的次数，默认为 10 次。
        #如果 retries 小于等于 0，该 ProducerBatch 首次发送失败后将直接进入失败队列。-->
        <retries>${retries}</retries>
        <!-- 首次重试的退避时间，默认为 100 毫秒。-->
        <baseRetryBackoffMs>${baseRetryBackoffMs}</baseRetryBackoffMs>
        <!--重试的最大退避时间，默认为 50 秒。-->
        <maxRetryBackoffMs>${maxRetryBackoffMs}</maxRetryBackoffMs>


        <!-- 可选项 通过配置 encoder 的 pattern 自定义 log 的格式 -->
        <encoder>
            <pattern>%d %-5level [%thread] %logger{0}: %msg</pattern>
        </encoder>

        <!-- 可选项 设置 time 字段呈现的格式 -->
        <timeFormat>${timeFormat}</timeFormat>
        <!-- 可选项 设置 time 字段呈现的时区 -->
        <timeZone>${timeZone}</timeZone>
        <mdcFields>tenantId,tid</mdcFields>
    </appender>
    <appender name="ASYNC_ALIYUN_SLS_LOG_APPENDER" class="com.github.sparkzxl.log.appender.ConditionalAsyncAppender">
        <enabled>${aliYunLogEnabled}</enabled>
        <discardingThreshold>0</discardingThreshold>
        <queueSize>256</queueSize>
        <appender-ref ref="ALIYUN_SLS_LOG_APPENDER"/>
    </appender>


    <!--nacos 心跳 INFO 屏蔽-->
    <logger name="com.alibaba.nacos" level="OFF">
        <appender-ref ref="CONSOLE_APPENDER"/>
    </logger>
</included>
