<?xml version="1.0" encoding="UTF-8"?>
<included>

    <!-- 彩色日志格式 -->
    <!-- 控制台输出 -->
    <springProperty scope="context" name="common-pattern-color" source="logging.common-pattern-color"
                    defaultValue="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${springAppName}){yellow} %highlight([%5p]) %clr(${PID:- }){magenta} %clr([tenantId: %X{tenantId:-N/A},traceId: %X{traceId:-N/A}]){green} %clr(---){faint} %clr([%15.15t:%r]){faint} %clr(%-40.40logger{15}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- 文件输出 -->
    <property name="file-log-pattern"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS}: ${springAppName} [${LOG_LEVEL_PATTERN:-%5p}] ${PID:- } [tenantId: %X{tenantId:-N/A},traceId: %X{traceId:-N/A}] [%-40.40logger{15}] : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
    <!-- JSON格式输出 -->
    <property name="json-log-pattern" value="{&quot;date&quot;: &quot;%d{yyyy-MM-dd HH:mm:ss.SSS}&quot;, &quot;level&quot;: &quot;%level&quot;, &quot;application&quot;: &quot;${springAppName}&quot;, &quot;tenantId&quot;: &quot;%X{tenantId:-N/A}&quot;, &quot;traceId&quot;: &quot;%X{tid:-N/A}&quot;, &quot;pid&quot;: &quot;${PID:-}&quot;, &quot;thread&quot;: &quot;%thread&quot;, &quot;class&quot;: &quot;%logger{15}&quot;, &quot;message&quot;: &quot;%message&quot;}"/>

</included>
